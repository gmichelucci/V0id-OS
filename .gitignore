# =========================================================================
# V0id OS — .gitignore Oficial
# Protege segredos (.env com API keys) e ignora builds pesados
# =========================================================================

# Chaves e Segredos de API (NUNCA SUBIR AO GITHUB)
.env
*.env
*.key
*.pem

# Dependências Node.js
node_modules/
ui-launcher/node_modules/

# Builds e Caches Next.js
.next/
ui-launcher/.next/
ui-launcher/out/
ui-launcher/tsconfig.tsbuildinfo

# Logs e Arquivos Temporários
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
test_followup.mjs
screenshots/temp_profile/
.temp_edge_profile/
.flow_browser/
v0id_loop.pid
v0id_loop.stop
loop_runner.log
.system_generated/

# Caches do Sistema e SQLite Databases Locais (Histórico e Mensagens)
*.db
*.db-shm
*.db-wal
*.db-journal
03_chat_projects_nexus/nexus-db/*.db*

# Mídias e Assets Gerados pelo Usuário (Privacidade Total)
ui-launcher/public/generated/*
!ui-launcher/public/generated/.gitkeep
projetos/*/assets/images/*
projetos/*/assets/videos/*
projetos/*/assets/audio/*
!projetos/**/.gitkeep

# Caches de Análise AST e Navegador
graphify-out/cache/
.flow_browser/
*/.flow_browser/

# Arquivos de Sistema Operacional
Thumbs.db
.DS_Store
