# V0ID OS API KEYS CONFIGURATION
# Insira uma ou mais chaves para rotação automática do OmniRoute

# Gemini AI Studio (Google) - Suporta múltiplas chaves separadas por vírgula
GEMINI_API_KEY=
# GEMINI_API_KEYS=key1,key2,key3

# Groq (Llama-3.3-70b-versatile, etc.)
GROQ_API_KEY=

# Cerebras (Llama-3.3-70b ultra-fast)
CEREBRAS_API_KEY=

# OpenRouter (Modelos gratuitos :free e rota sem censura)
OPENROUTER_API_KEY=

# Porta do WebSocket Server
V0ID_PORT=7777

# Modo Caveman (1 = Ativo, 0 = Inativo)
CAVEMAN_MODE=1

# Modelo Default Gatekeeper
GATEKEEPER_MODEL=gemini-3.8-flash

# Modelo Default Principal
PRIMARY_MODEL=gemini-3.8-flash

# Google Flow Project URL (Opcional - padrão: https://flow.google.com/)
# GOOGLE_FLOW_PROJECT_URL=

# Diretório Local de Sincronização em Nuvem (Opcional)
# GDRIVE_SYNC_PATH=

